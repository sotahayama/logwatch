generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogLevel {
  debug
  info
  notice
  error
  fault
}

// ログを送ってくる端末。エージェント用トークンはハッシュだけを保存し、平文は登録時に一度だけ表示する。
model Host {
  id         Int           @id @default(autoincrement())
  name       String        @unique
  tokenHash  String        @unique
  createdAt  DateTime      @default(now())
  lastSeenAt DateTime?
  counts     MinuteCount[]
  anomalies  Anomaly[]
}

enum AnomalyKind {
  spike // 平常時より件数が急増した
  silence // 普段ログを出すプロセスが0件になった
}

enum Detector {
  statistical // 受信時に server が判定する(直前60分の中央値との比較)
  pca // detector/ の Python ワーカーが判定する(主成分分析)
}

// 分ごとの検知結果。同じ分を判定し直したら、その検知方法の結果を置き換える。
model Anomaly {
  hostId     Int
  host       Host        @relation(fields: [hostId], references: [id])
  detector   Detector    @default(statistical)
  minute     DateTime
  process    String
  level      LogLevel
  kind       AnomalyKind
  count      Int
  baseline   Float // 平常時の件数(統計的な方法は直前の中央値、PCA は全体の状態からの予想)
  score      Float // 平常時のばらつき何個分ずれているか
  detectedAt DateTime    @default(now())

  @@id([hostId, detector, minute, process, level])
  @@index([hostId, detector, minute])
}

// 1分 × プロセス × 重要度 のログ件数。エージェントは送信失敗時に同じ分を送り直すため、
// 主キーで一意にして「足し込み」ではなく「置き換え」で保存する(何度届いても同じ結果になる)。
model MinuteCount {
  hostId     Int
  host       Host     @relation(fields: [hostId], references: [id])
  minute     DateTime
  process    String
  level      LogLevel
  count      Int
  receivedAt DateTime @default(now())

  @@id([hostId, minute, process, level])
  @@index([hostId, minute])
}
